# --- RAG pipeline uretilen ciktilar (main dalindan) ---
knowledge-base/rag/chunks/*
knowledge-base/rag/embeddings/*

# Klasor yapisini koru
!knowledge-base/rag/chunks/.gitkeep
!knowledge-base/rag/embeddings/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- Kazima araci calisma durumu ---
# Markdown ciktisinin kendisi depoya girer (knowledge-base/markdown/),
# ama araca ait gecici durum dosyalari girmez.
.netsis-scraper-state.sqlite3*
.netsis-catalog.json
_rapor.txt
scripts/netsis-docs/
netsis-docs/

# --- Isletim sistemi ---
.DS_Store
Thumbs.db
